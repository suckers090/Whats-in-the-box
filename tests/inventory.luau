local catalog = require("../src/ReplicatedStorage/ItemCatalog")
local rules = require("../src/ServerScriptService/InventoryState")(catalog)
local first, visitor = rules.New(), rules.New()
local weight = 0
for _, item in ipairs(catalog) do weight += item.weight end
assert(weight == 10000, "Expanded weights must match the tested catalog distribution")
assert(rules.Resolve(first, "Sell") == nil, "No reward without an opened item")
assert(rules.Discover(first, "gold_watch"))
assert(not rules.Discover(first, "old_toy"), "Pending choice blocks another reward")
assert(rules.Resolve(first, "ForgedDecision") == nil)
assert(first.pending == "gold_watch", "Invalid decisions must not consume reward")
assert(rules.Resolve(visitor, "Sell") == nil, "Visitors cannot resolve another session's reward")
assert(rules.Resolve(first, "Keep") == 0)
assert(first.inventory.gold_watch == 1)
assert(first.discoveries.gold_watch == 1)
assert(rules.Resolve(first, "Sell") == nil, "Repeated remote cannot pay twice")
assert(rules.Sell(visitor, "gold_watch") == nil)
assert(rules.Sell(first, "unknown") == nil)
assert(rules.Sell(first, {}) == nil)
assert(rules.Sell(first, "gold_watch") == 2500)
assert(rules.Sell(first, "gold_watch") == nil, "Cannot sell more than owned")
assert(first.discoveries.gold_watch == 1, "Selling keeps index progress")
assert(rules.Discover(first, "gold_watch"))
assert(rules.Resolve(first, "Sell") == 2500)
assert(first.discoveries.gold_watch == 2 and first.inventory.gold_watch == 0)
assert(visitor.discoveries.gold_watch == nil, "Player states must stay isolated")
local fresh = rules.New()
assert(next(fresh.inventory) == nil and next(fresh.discoveries) == nil)
print("PASS: RNG weights, discovery, keep/sell, invalid/replayed requests, session isolation and index retention")
